{
  "name": "farm-to-flat",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:customer": "pnpm --filter customer start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "prettier --write \"**/*.{js,jsx,json,md,css}\"",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "husky": "9.1.7",
    "lint-staged": "16.1.6",
    "prettier": "3.6.2",
    "turbo": "2.5.6"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd",
      "msgpackr-extract",
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  }
}
