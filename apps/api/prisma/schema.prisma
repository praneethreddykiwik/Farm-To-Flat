// Farm-to-Flat production database — Postgres (Supabase).
//
// This mirrors the current in-memory store (apps/api/src/store.js + customer-store.js) one-to-one,
// so the API's route contracts don't change when we swap the Maps for real tables. Money is ALWAYS
// integer paise (Int) — never floats. Apply with:  pnpm prisma migrate dev --name init
//
// DATABASE_URL = Supabase pooler (port 6543, ?pgbouncer=true) for the app at runtime.
// DIRECT_URL   = Supabase direct (port 5432) for migrations only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─────────────────────────── enums ───────────────────────────
enum Unit {
  KG
  BUNCH
  PIECE
  DOZEN
  PACK
}

enum Diet {
  VEG
  NONVEG
}

enum Availability {
  AVAILABLE
  SOLD_OUT
  HIDDEN
}

enum CouponType {
  PERCENT
  FLAT
  FREE_ITEM
}

enum StaffRole {
  SUPER_ADMIN
  ADMIN
  PROCUREMENT
  FULFILMENT
}

enum ProcurementStatus {
  AUTO_APPROVED
  NEEDS_APPROVAL
  APPROVED
  REJECTED
}

// ─────────────────────────── catalog ───────────────────────────
model Category {
  id       String    @id
  name     String
  tint     String?
  order    Int       @default(0)
  products Product[]
}

model Product {
  id             String       @id @default(cuid())
  category       Category     @relation(fields: [categoryId], references: [id])
  categoryId     String
  name           String
  aliases        String[]     @default([])
  unit           Unit
  increment      Decimal      @db.Decimal(10, 3)
  pricePaise     Int
  costPaise      Int          @default(0) // operator-only; never serialized to customers
  dailyCap       Int          @default(100)
  bufferPct      Int          @default(10)
  farm           String?
  image          String?
  blurhash       String?
  variableWeight Boolean      @default(false)
  diet           Diet         @default(VEG)
  isSeasonal     Boolean      @default(false)
  isActive       Boolean      @default(true)
  availability   Availability @default(AVAILABLE)
  createdAt      DateTime     @default(now())

  @@index([categoryId])
  @@index([diet])
  @@index([isSeasonal])
}

model Community {
  id             String    @id @default(cuid())
  name           String
  area           String?
  blocks         String[]  @default([])
  deliveryDays   Int[]     @default([]) // 0=Sun … 6=Sat
  // Same-day IST cut-off clock times ("HH:MM") — a window closes at this time on its own delivery
  // date; there is no capacity/count limit. cutoffHours/windowCapacity below are unused legacy
  // columns, kept (not dropped) so this migration stays additive and reversible.
  /// The delivery windows this community runs: [{ key, label, cutoff, start, end }, …], in the
  /// order of the day. Operator-editable — a community can run one window or six. `key` is what an
  /// ORDER stores, so it is never rewritten once issued; deleting a window stops it being offered
  /// but leaves past orders readable. Empty on rows written before windows were a list, which the
  /// API reads as the MORNING/EVENING pair described by the two columns below.
  windows              Json    @default("[]")
  /// Legacy cut-off columns. Nothing reads them once `windows` is populated; they are kept in sync
  /// for the MORNING/EVENING entries so rolling this deploy back leaves coherent data.
  morningCutoff        String  @default("03:45")
  eveningCutoff        String  @default("15:00")
  cutoffWarningMinutes Int     @default(15)
  /// How many days ahead the SOONEST deliverable day is. 1 = order today, delivered tomorrow, which
  /// is what gives the farm a night to harvest against real orders. 0 allows same-day.
  orderLeadDays        Int     @default(1)
  cutoffHours    Int       @default(10)
  windowCapacity Int       @default(30)
  isActive       Boolean   @default(true)
  addresses      Address[]
}

model Coupon {
  code          String     @id
  label         String?
  type          CouponType
  valueBp       Int? // PERCENT: basis points (1000 = 10%)
  valuePaise    Int? // FLAT: rupees off, in paise
  freeProductId String? // FREE_ITEM
  minOrderPaise Int        @default(0)
  batchId       String?
  expiresAt     DateTime
  globalCap     Int?
  redeemedCount Int        @default(0)
  isActive      Boolean    @default(true)
  redemptions   CouponRedemption[]
}

// One redemption per customer per coupon (enforces "already used on your account").
model CouponRedemption {
  id         String   @id @default(cuid())
  coupon     Coupon   @relation(fields: [couponCode], references: [code])
  couponCode String
  customer   Customer @relation(fields: [customerId], references: [id])
  customerId String
  createdAt  DateTime @default(now())

  @@unique([couponCode, customerId])
}

// ─────────────────────────── customers & auth ───────────────────────────
model Customer {
  id                 String             @id
  mobile             String             @unique
  name               String?
  email              String?
  walletBalancePaise Int                @default(0)
  walletLedger       Json               @default("[]") // display history (mirrors in-memory ledger)
  createdAt          DateTime           @default(now())
  addresses          Address[]
  payments           Payment[]
  devices            Device[]
  sessions           Session[]
  redemptions        CouponRedemption[]
}

// Refresh tokens (rotated on use). Short-lived OTPs belong in Redis (REDIS_URL), not here.
model Session {
  refreshToken String   @id
  customer     Customer @relation(fields: [customerId], references: [id])
  customerId   String
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@index([customerId])
}

model Device {
  expoPushToken String   @id
  customer      Customer @relation(fields: [customerId], references: [id])
  customerId    String
  createdAt     DateTime @default(now())

  @@index([customerId])
}

model Address {
  id            String    @id
  customer      Customer  @relation(fields: [customerId], references: [id])
  customerId    String
  community     Community @relation(fields: [communityId], references: [id])
  communityId   String
  block         String
  flat          String
  floor         String?
  landmark      String?
  recipientName String?
  contactNumber String?
  isDefault     Boolean   @default(false)

  @@index([customerId])
}

// ─────────────────────────── orders ───────────────────────────
// Self-contained: line items, the delivery-address snapshot and the status timeline are stored as
// JSON, exactly mirroring the in-memory order object (which the admin analytics + serializers read).
// customerId is nullable so seeded/guest demo orders persist too. Money is Int paise; the JSON items
// also carry integer-paise fields. costPaise/unitCostPaise are operator-only (never serialized out).
model Order {
  id                  String   @id
  orderNumber         String   @unique
  status              String   @default("CONFIRMED")
  customerId          String?
  customerName        String?
  mobile              String?
  items               Json     @default("[]")
  address             Json?
  timeline            Json     @default("[]")
  subtotalPaise       Int
  costPaise           Int      @default(0)
  couponCode          String?
  couponDiscountPaise Int      @default(0)
  deliveryChargePaise Int      @default(0)
  totalPaise          Int
  walletAppliedPaise  Int      @default(0)
  gatewayAmountPaise  Int      @default(0)
  deliveryDate        String?
  window              String?
  deliveryNote        String?
  paymentMethod       String   @default("PREPAID") // PREPAID | COD
  codCollectedPaise   Int      @default(0)
  codCollectedAt      String?
  deliveryOtp         String?
  deliveryOtpIssuedAt String?
  deliveredAt         String?
  /// Complaints the customer raised about this delivery — photographs, what they said, and what
  /// the operator decided. Kept on the order because that is the only thing they are ever about.
  issues              Json     @default("[]")
  cancelRequested     Boolean  @default(false)
  cancelReason        String?
  cancelRequestedAt   String?
  createdAt           String // ISO string, mirrors the in-memory order

  @@index([status])
  @@index([customerId])
}

// ─────────────────────────── money ───────────────────────────
model Payment {
  id                String   @id
  customer          Customer @relation(fields: [customerId], references: [id])
  customerId        String
  orderId           String?
  purpose           String // ORDER | WALLET_TOPUP
  amountPaise       Int
  status            String   @default("CREATED")
  razorpayOrderId   String?
  razorpayPaymentId String?
  createdAt         DateTime @default(now())

  @@index([customerId])
  @@index([orderId])
}

// ─────────────────────────── operations ───────────────────────────
model Staff {
  id        String    @id @default(cuid())
  mobile    String    @unique
  name      String?
  role      StaffRole
  aiAccess  Boolean   @default(false)
  createdAt DateTime  @default(now())
}

// The price procurement actually paid for a line, and its approval state against the cost buffer.
model ProcurementRecord {
  dateKey         String
  productId       String
  estCostPaise    Int
  actualCostPaise Int
  variancePct     Float?
  status          ProcurementStatus
  submittedAt     DateTime          @default(now())
  decidedAt       DateTime?

  @@id([dateKey, productId])
}

// App-wide settings (min order, procurement buffer, support contact) as a single row.
/// A shopper's basket. Kept in Postgres because the API holds carts in memory: before this, every
/// server restart (and on the free plan, every overnight idle spin-down) silently emptied the
/// basket of every customer who had not yet checked out.
model Cart {
  customerId String   @id
  items      Json     @default("[]")
  couponCode String?
  updatedAt  DateTime @updatedAt
}

model AppConfig {
  id                        Int      @id @default(1)
  minOrderValuePaise        Int      @default(50000)
  deliveryChargePaise       Int      @default(0)
  procurementCostBufferPct  Int      @default(2)
  procurementAutoApprove    Boolean  @default(true)
  supportEmail              String?  @default("support@farmtoflat.in")
  supportPhone              String?  @default("")
  supportShowEmail          Boolean  @default(true)
  supportShowPhone          Boolean  @default(false)
  /// Cash on delivery. Off by default: it must be a deliberate decision, because an unpaid order
  /// costs a real packed bag if nobody answers the door.
  codEnabled                Boolean  @default(false)
  /// Largest order that may be paid in cash. Keeps a ₹9,000 cash order off a rider's person.
  codMaxOrderPaise          Int      @default(300000)
  /// Require the customer to read out a one-time code at the door before an order counts as
  /// delivered. Proof of hand-over, and for a cash order proof the money changed hands.
  deliveryOtpEnabled        Boolean  @default(true)
  updatedAt                 DateTime @updatedAt
}
