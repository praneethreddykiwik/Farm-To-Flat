# Public values only. Anything here ships inside the app bundle and is visible to anyone.
# Never put a service-role key, database URL, Razorpay key secret or webhook secret in this file.

# Base URL of Tharun's Express API (no trailing slash). Base path /api/v1 is appended by the client.
# For a phone on the same Wi-Fi as your laptop use your LAN IP, e.g. http://192.168.1.20:4000
EXPO_PUBLIC_API_URL=http://localhost:4000

# 1 = run against the in-app mock server (no backend needed). 0 = real API.
EXPO_PUBLIC_USE_MOCKS=1

# Razorpay publishable key id (rzp_test_...). The key SECRET stays on the server.
EXPO_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Supabase anon key is read-only Storage access at most. Not used in P1 screens.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# AI diet planner (DEV ONLY — these ship in the bundle; production calls POST /api/v1/ai/plan on the server)
EXPO_PUBLIC_AI_PROVIDER=groq            # groq | gemini
EXPO_PUBLIC_GROQ_API_KEY=
EXPO_PUBLIC_GROQ_MODEL=openai/gpt-oss-120b
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-3.6-flash
