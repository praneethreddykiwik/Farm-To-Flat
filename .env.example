# Server-side secrets (apps/api). NEVER copy any of these into apps/customer or apps/admin.
DATABASE_URL=            # pooler, 6543, ?pgbouncer=true&connection_limit=1
DIRECT_URL=              # direct, 5432, migrations only
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
REDIS_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_OTP_TEMPLATE_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# AI planner (server-side; the app calls /ai/plan, never the provider directly in prod)
AI_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
MIN_ORDER_VALUE_PAISE=50000
ORDER_RELEASE_MINUTES=20
SENTRY_DSN=
# Hardening (production). CORS_ORIGIN: comma-separated allowlist of admin/site origins; unset = open
# (dev only). NODE_ENV=production makes the admin API refuse requests unless ADMIN_TOKEN is set.
NODE_ENV=
CORS_ORIGIN=             # e.g. https://admin.farmtoflat.in
ADMIN_TOKEN=             # required in production; callers send it as the x-admin-token header

# Operator sign-in with Google (admin panel). BOTH of these are needed before the Google button
# appears — a client id with an empty allowlist would let anyone sign in and then reject them all.
# GOOGLE_CLIENT_ID: the OAuth 2.0 Web client id, with every admin domain listed under
#   "Authorized JavaScript origins" in Google Cloud Console. It is public by design.
# ADMIN_GOOGLE_EMAILS: who may actually open the panel, as email[:ROLE], comma-separated. A bare
#   address gets ADMIN; roles are SUPER_ADMIN, ADMIN, PROCUREMENT, FULFILMENT. Removing an address
#   takes effect on that person's NEXT request, not when their session expires.
# ADMIN_SESSION_SECRET: signs the operator session. 32+ random characters. Unset means a new random
#   secret each boot, which signs every operator out on every deploy. There is no default.
GOOGLE_CLIENT_ID=
ADMIN_GOOGLE_EMAILS=     # e.g. owner@fooducia.in:SUPER_ADMIN, ops@fooducia.in
ADMIN_SESSION_SECRET=

# Private media links (complaint photographs). Signs the short-lived token in the photo URL, so the
# API can serve the image itself instead of sending the browser to the storage provider — which is
# what broke the complaints queue: *.supabase.co resolves to an ISP-owned address on at least one
# large Indian network, so every photo failed at the TLS handshake. Falls back to
# ADMIN_SESSION_SECRET; unset means a random per-boot secret, so photo links break at every deploy.
MEDIA_TOKEN_SECRET=

# Object storage. 'supabase' (default) or 's3'. Everything is referenced by PATH and served through
# this API, so switching is a config change: copy the objects with
# `node prisma/migrate-storage.mjs --go`, then set STORAGE_DRIVER=s3 and redeploy. Supabase stays
# untouched as the rollback.
STORAGE_DRIVER=
S3_BUCKET=
AWS_REGION=                # e.g. ap-south-1 (Mumbai)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_ENDPOINT=               # only for S3-compatible providers; leave blank for AWS
S3_PUBLIC_BASE=            # CDN/public origin for PRODUCT images, e.g. https://img.fooducia.in
